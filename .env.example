# =========================================================
# TRIPLE Z — ENVIRONMENT CONFIGURATION
# =========================================================

# 1. Site URL (رابط الموقع)
SITE_URL=https://triplezzz.vercel.app

# 2. Admin Access (بيانات دخول الأدمن)
# ADMIN_USERNAME / ADMIN_PASSWORD are a bootstrap login only: they work until a password
# is saved in the database (from the admin panel or scripts/setup-admin-user.js), then stop working.
# Password must be at least 12 characters, otherwise env login is disabled.
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=change_me_to_a_long_random_password
# Required: signs admin sessions. At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs out every admin.
ADMIN_SESSION_SECRET=

# 3. Cryptographic Secrets (التشفير والجلسات)
CUSTOMER_SESSION_SECRET=your_32_bytes_hex_random_secret_here
PASSWORD_SALT=your_random_salt_here

# =========================================================
# 3. DIRECT POSTGRESQL POOLER (الاتصال المباشر بقاعدة البيانات)
# =========================================================
# الخيار أ: رابط الاتصال الكامل (Direct Pooler Connection String)
# مثال: postgres://postgres.yourproject:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# الخيار ب: تفاصيل الاتصال المباشرة منفصلة (Host / Port / User / Pass / DB)
PGHOST=
PGPORT=6543
PGUSER=postgres
PGPASSWORD=
PGDATABASE=postgres
PGSSL=true

# =========================================================
# 4. SUPABASE API (اختياري في حال استخدام Supabase SDK)
# =========================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=