# =========================================================
# TRIPLE Z — ENVIRONMENT CONFIGURATION
# =========================================================

# 1. Site URL (رابط الموقع)
SITE_URL=https://triplezzz.vercel.app

# 2. Master Admin Access (بيانات دخول الأدمن)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password_here

# 3. Cryptographic Secrets (التشفير والجلسات)
CUSTOMER_SESSION_SECRET=your_32_bytes_hex_random_secret_here
PASSWORD_SALT=your_random_salt_here

# =========================================================
# 3. DIRECT POSTGRESQL POOLER (الاتصال المباشر بقاعدة البيانات)
# =========================================================
# الخيار أ: رابط الاتصال الكامل (Direct Pooler Connection String)
# مثال: postgres://postgres.yourproject:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# الخيار ب: تفاصيل الاتصال المباشرة منفصلة (Host / Port / User / Pass / DB)
PGHOST=
PGPORT=6543
PGUSER=postgres
PGPASSWORD=
PGDATABASE=postgres
PGSSL=true

# =========================================================
# 4. SUPABASE API (اختياري في حال استخدام Supabase SDK)
# =========================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=