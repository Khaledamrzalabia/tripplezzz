# Triple Z — Environment Configuration

# Public Site URL (Used for sitemaps, OpenGraph, Canonical URLs)
NEXT_PUBLIC_SITE_URL=https://triple-z.com

# Analytics & Monitoring (Optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Admin Authentication (Optional secret for admin API routes)
# ADMIN_API_SECRET=your-secure-random-token-here

# Node Environment
NODE_ENV=production
